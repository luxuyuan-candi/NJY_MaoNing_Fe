<view class="top-page">
  <image class="page-bg" src="../../images/feedback_top5/bg.jpg" mode="widthFix"></image>

  <view class="top-content">
    <view class="ranking-panel">
      <view wx:if="{{rows.length}}">
        <block wx:for="{{rows}}" wx:key="problem_category">
          <view class="rank-item">
            <image class="rank-badge" src="{{item.rankIcon}}" mode="aspectFit"></image>
            <image class="category-icon" src="{{item.categoryIcon}}" mode="aspectFit"></image>
            <view class="rank-main">
              <view class="rank-head">
                <text class="category-name">{{item.categoryLabel}}</text>
                <text class="category-count">{{item.count}} 条</text>
              </view>
              <view class="bar-track">
                <view class="bar-fill" style="width: {{item.percent}}%;"></view>
              </view>
            </view>
          </view>
          <view wx:if="{{index < rows.length - 1}}" class="rank-divider">
            <view class="divider-line"></view>
          </view>
        </block>
      </view>
      <view wx:else class="empty-note">暂无消极反馈</view>
    </view>
  </view>
</view>
