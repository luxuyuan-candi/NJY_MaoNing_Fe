.top-page {
  background:
    radial-gradient(circle at top right, rgba(233, 212, 195, 0.72), transparent 34%),
    linear-gradient(180deg, #f7f4ef 0%, #f5efe7 100%);
}

.top-hero,
.top-card {
  padding: 30rpx;
}

.top-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #2f342f;
}

.top-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f7469;
}

.top-card {
  margin-top: 22rpx;
}

.top-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.top-item + .top-item {
  border-top: 1rpx dashed #e0d8ce;
}

.rank-badge {
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #f8e7dc;
  color: #a15a3d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
  flex-shrink: 0;
}

.top-main {
  flex: 1;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #32312d;
}

.category-count {
  font-size: 23rpx;
  color: #8a5e4a;
}

.bar-track {
  height: 14rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #efe7dc;
}

.bar-fill {
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d28c68 0%, #a15a3d 100%);
}

.empty-note {
  padding: 60rpx 0;
  text-align: center;
  color: #8a7d72;
}
