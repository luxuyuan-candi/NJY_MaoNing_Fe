.top-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #eff7dd;
}

.page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  z-index: 0;
}

.top-content {
  position: relative;
  z-index: 1;
  padding: 230rpx 32rpx 0;
  box-sizing: border-box;
}

.ranking-panel {
  min-height: 850rpx;
  padding: 42rpx 34rpx 40rpx;
  box-sizing: border-box;
}

.rank-item {
  display: flex;
  align-items: center;
  min-height: 118rpx;
}

.rank-badge {
  width: 82rpx;
  height: 82rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.category-icon {
  width: 110rpx;
  height: 110rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.category-name {
  color: #164d1c;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.category-count {
  color: #6b4426;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
  flex-shrink: 0;
}

.bar-track {
  height: 22rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(226, 218, 199, 0.72);
}

.bar-fill {
  height: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8daf2e 0%, #6d9c2f 100%);
}

.rank-divider {
  height: 54rpx;
  display: flex;
  align-items: center;
  padding-left: 88rpx;
  box-sizing: border-box;
}

.divider-line {
  width: 100%;
  height: 2rpx;
  border-top: 2rpx dashed rgba(192, 203, 158, 0.75);
}

.empty-note {
  padding: 260rpx 0;
  text-align: center;
  color: #6d7c5d;
  font-size: 28rpx;
  font-weight: 700;
}
