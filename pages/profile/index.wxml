<view class="page-shell profile-page">
  <image class="profile-page-bg" src="../../images/profile/page-bg.jpg" mode="widthFix"></image>
  <view
    bindtap="goToSettings"
    class="profile-hero"
  >
    <image class="profile-hero-bg" src="../../images/profile/hero-bg.jpg" mode="aspectFill"></image>
    <view style="display: flex; flex-direction: row; align-items: flex-start;">
      <view style="width: 160rpx; margin-top: 58rpx; flex-shrink: 0;">
        <view style="width: 160rpx; height: 160rpx; border-radius: 80rpx; overflow: hidden; border: 10rpx solid rgba(255,255,255,0.96); box-shadow: 0 14rpx 36rpx rgba(102,124,77,0.16); background: linear-gradient(180deg,#5e9b4b 0%,#4b7c3f 100%);">
          <image wx:if="{{profile.avatar}}" src="{{profile.avatar}}" mode="aspectFill" style="width: 160rpx; height: 160rpx;"></image>
          <view wx:else style="width: 160rpx; height: 160rpx; color: #fffef8; font-size: 56rpx; font-weight: 700; text-align: center; line-height: 160rpx;">{{avatarInitial}}</view>
        </view>
      </view>

      <view style="flex: 1; padding-top: 72rpx; padding-left: 24rpx; box-sizing: border-box;">
        <text style="display: block; color: #26322a; font-size: 52rpx; line-height: 1.08; font-weight: 700;">{{profile.nickname}}</text>
        <view style="display: inline-flex; align-items: center; margin-top: 22rpx; padding: 10rpx 22rpx 10rpx 14rpx; border-radius: 999rpx; background: linear-gradient(180deg, rgba(241,249,230,0.98) 0%, rgba(232,244,212,0.98) 100%);">
          <image
            src="{{profile.isAdmin ? '../../images/profile/badge-admin.svg' : '../../images/profile/badge-user.svg'}}"
            mode="aspectFit"
            style="width: 30rpx; height: 30rpx; margin-right: 10rpx;"
          ></image>
          <text style="color: #5d9348; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx;">{{profile.userType}}</text>
        </view>
        <text style="display: block; margin-top: 28rpx; color: #666358; font-size: 23rpx; line-height: 1.8;">一起让中药渣重生，为猫咪造福</text>
      </view>

      <image src="../../images/profile/chevron-right.svg" mode="aspectFit" style="width: 28rpx; height: 28rpx; margin-top: 142rpx; margin-left: 16rpx; flex-shrink: 0;"></image>
    </view>
  </view>

    <view style="position: relative; z-index: 2; margin-top: 32rpx; border-radius: 36rpx; padding: 34rpx 28rpx 34rpx; background: rgba(255,252,246,0.88); box-shadow: 0 18rpx 46rpx rgba(168,164,125,0.14);">
    <view style="display: flex; flex-direction: row; align-items: center; margin-bottom: 30rpx;">
      <text style="color: #27322b; font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx;">工具区</text>
    </view>

    <view wx:if="{{profile.isAdmin}}" style="display: flex; flex-direction: row; justify-content: flex-start;">
      <view
        bindtap="goToFeedback"
        style="width: 23%; min-height: 166rpx; border-radius: 28rpx; background: linear-gradient(180deg, rgba(255,253,247,0.96) 0%, rgba(248,245,236,0.98) 100%); box-shadow: inset 0 0 0 2rpx rgba(244,239,225,0.92), 0 12rpx 24rpx rgba(187,183,145,0.10); padding: 18rpx 8rpx 16rpx; box-sizing: border-box;"
      >
        <view style="height: 92rpx; display: flex; align-items: center; justify-content: center;">
          <image src="../../images/profile/tool-feedback-card.svg" mode="aspectFit" style="width: 88rpx; height: 88rpx;"></image>
        </view>
        <text style="display: block; margin-top: 10rpx; text-align: center; color: #223328; font-size: 22rpx; font-weight: 700; line-height: 1.25;">用户反馈</text>
      </view>

      <view
        wx:if="{{profile.isSuperAdmin}}"
        bindtap="goToUsers"
        style="width: 23%; min-height: 166rpx; margin-left: 20rpx; border-radius: 28rpx; background: linear-gradient(180deg, rgba(250,252,246,0.98) 0%, rgba(240,247,231,0.98) 100%); box-shadow: inset 0 0 0 2rpx rgba(236,244,223,0.92), 0 12rpx 24rpx rgba(187,183,145,0.10); padding: 18rpx 8rpx 16rpx; box-sizing: border-box;"
      >
        <view style="height: 92rpx; display: flex; align-items: center; justify-content: center;">
          <image src="../../images/profile/tool-manage-card.svg" mode="aspectFit" style="width: 88rpx; height: 88rpx;"></image>
        </view>
        <text style="display: block; margin-top: 10rpx; text-align: center; color: #223328; font-size: 22rpx; font-weight: 700; line-height: 1.25;">用户管理</text>
      </view>
    </view>

    <view
      wx:else
      bindtap="goToFeedback"
      style="width: 23%; min-height: 166rpx; border-radius: 28rpx; background: linear-gradient(180deg, rgba(255,253,247,0.96) 0%, rgba(248,245,236,0.98) 100%); box-shadow: inset 0 0 0 2rpx rgba(244,239,225,0.92), 0 12rpx 24rpx rgba(187,183,145,0.10); padding: 18rpx 8rpx 16rpx; box-sizing: border-box;"
    >
      <view style="height: 92rpx; display: flex; align-items: center; justify-content: center;">
        <image src="../../images/profile/tool-feedback-card.svg" mode="aspectFit" style="width: 88rpx; height: 88rpx;"></image>
      </view>
      <text style="display: block; margin-top: 10rpx; text-align: center; color: #223328; font-size: 22rpx; font-weight: 700; line-height: 1.25;">帮助工具</text>
    </view>
</view>
</view>
