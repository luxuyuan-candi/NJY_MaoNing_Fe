<view class="page-shell profile-page">
  <view class="profile-card profile-hero" bindtap="goToSettings">
    <view class="avatar-shell">
      <image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"></image>
      <view wx:else class="avatar-fallback">{{avatarInitial}}</view>
    </view>
    <view class="profile-copy">
      <text class="profile-name">{{profile.nickname}}</text>
      <text class="profile-type">{{profile.userType}}</text>
    </view>
    <view class="profile-arrow">›</view>
  </view>

  <view class="profile-card tool-card">
    <view class="tool-head">
      <text class="tool-title">工具区</text>
      <text class="tool-subtitle">{{profile.userType === '管理员' ? '查看并处理用户反馈' : '提交帮助反馈与使用建议'}}</text>
    </view>
    <view class="tool-item" bindtap="goToFeedback">
      <view class="tool-icon">?</view>
      <view class="tool-copy">
        <text class="tool-name">帮助工具</text>
        <text class="tool-desc">{{profile.userType === '管理员' ? '查看反馈' : '提交反馈'}}</text>
      </view>
      <view class="tool-arrow">›</view>
    </view>
  </view>
</view>
