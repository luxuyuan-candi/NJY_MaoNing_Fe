.profile-page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  padding: 34rpx 28rpx 72rpx;
  background: linear-gradient(180deg, #faf7ef 0%, #f7f3e8 100%);
  box-sizing: border-box;
}

.profile-page-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  min-height: 100%;
  z-index: 0;
  opacity: 0.96;
}

.profile-hero,
.tool-card {
  position: relative;
  z-index: 1;
}

.profile-hero {
  min-height: 366rpx;
  border-radius: 38rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx rgba(152, 155, 107, 0.13);
}

.profile-hero-bg {
  width: 100%;
  height: 100%;
  min-height: 366rpx;
}

.profile-hero-content {
  position: absolute;
  inset: 0;
  padding: 78rpx 36rpx 40rpx 34rpx;
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  box-sizing: border-box;
}

.avatar-shell {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(180deg, #5e9b4b 0%, #4b7c3f 100%);
  box-shadow: 0 14rpx 38rpx rgba(102, 124, 77, 0.16);
  border: 10rpx solid rgba(255, 255, 255, 0.96);
  flex-shrink: 0;
  margin-top: 58rpx;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffef8;
  font-size: 58rpx;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  padding-top: 72rpx;
}

.profile-name {
  display: block;
  color: #26322a;
  font-size: 54rpx;
  line-height: 1.08;
  font-weight: 700;
  word-break: break-all;
  letter-spacing: 1rpx;
}

.profile-type-badge {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx 10rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(241, 249, 230, 0.98) 0%, rgba(232, 244, 212, 0.98) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(222, 238, 198, 0.92);
}

.profile-type-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.profile-type {
  color: #5d9348;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.profile-note {
  display: block;
  margin-top: 30rpx;
  color: #666358;
  font-size: 23rpx;
  line-height: 1.8;
}

.profile-arrow {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 146rpx;
  opacity: 0.92;
}

.tool-card {
  margin-top: 34rpx;
  border-radius: 38rpx;
  padding: 38rpx 34rpx 36rpx;
  background: rgba(255, 252, 246, 0.84);
  box-shadow: 0 20rpx 52rpx rgba(168, 164, 125, 0.14);
  backdrop-filter: blur(8rpx);
}

.tool-head {
  margin-bottom: 34rpx;
}

.tool-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tool-title-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.tool-title {
  color: #27322b;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.tool-panel {
  min-height: 392rpx;
  padding: 34rpx 26rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 253, 247, 0.96) 0%, rgba(248, 245, 236, 0.98) 100%);
  box-shadow:
    inset 0 0 0 2rpx rgba(244, 239, 225, 0.92),
    0 18rpx 42rpx rgba(187, 183, 145, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  width: 48%;
}

.tool-panel-soft {
  background: linear-gradient(180deg, rgba(250, 252, 246, 0.98) 0%, rgba(240, 247, 231, 0.98) 100%);
}

.tool-panel-visual {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-panel-graphic {
  width: 248rpx;
  height: 248rpx;
}

.tool-panel-title {
  margin-top: 18rpx;
  color: #223328;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.tool-grid-single .tool-panel {
  min-height: 418rpx;
  width: 100%;
}

.tool-grid-single .tool-panel-graphic {
  width: 266rpx;
  height: 266rpx;
}
