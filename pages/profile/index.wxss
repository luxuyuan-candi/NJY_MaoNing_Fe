.profile-page {
  background:
    radial-gradient(circle at top left, rgba(239, 229, 214, 0.8), transparent 32%),
    radial-gradient(circle at top right, rgba(225, 238, 226, 0.78), transparent 28%),
    linear-gradient(180deg, #f7f4ef 0%, #f5efe7 100%);
}

.profile-hero,
.tool-card {
  padding: 30rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-shell {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(180deg, #4f8e5c 0%, #3a6e49 100%);
  box-shadow: 0 14rpx 28rpx rgba(70, 111, 76, 0.14);
  flex-shrink: 0;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2b332d;
  word-break: break-all;
}

.profile-type {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #edf5ec;
  color: #4c7a57;
  font-size: 22rpx;
  font-weight: 700;
}

.profile-arrow,
.tool-arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  line-height: 1;
  color: #8e847a;
}

.tool-card {
  margin-top: 22rpx;
}

.tool-head {
  margin-bottom: 22rpx;
}

.tool-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2f342f;
}

.tool-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #80746a;
  line-height: 1.6;
}

.tool-item {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fbf8f2 0%, #f2ece3 100%);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.tool-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e8f1ea;
  color: #4f865b;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tool-copy {
  flex: 1;
  min-width: 0;
}

.tool-item + .tool-item {
  margin-top: 16rpx;
}

.tool-item-admin {
  background: linear-gradient(180deg, #f5fbf5 0%, #eaf4eb 100%);
}

.tool-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #34312d;
}

.tool-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7f7469;
}
