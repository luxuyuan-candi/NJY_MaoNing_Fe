.profile-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 24rpx 72rpx;
  overflow: hidden;
  background: #f8f4ea;
}

.profile-page-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  z-index: 0;
}

.profile-hero {
  position: relative;
  z-index: 2;
  min-height: 360rpx;
  padding: 70rpx 32rpx 36rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 42rpx rgba(152, 155, 107, 0.13);
  background: #fbf8f1;
}

.profile-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.profile-hero > view {
  position: relative;
  z-index: 1;
}
