.cat-page {
  background:
    radial-gradient(circle at top right, rgba(221, 236, 225, 0.8), transparent 28%),
    radial-gradient(circle at top left, rgba(245, 236, 220, 0.82), transparent 30%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.cat-hero,
.cat-panel,
.cat-card,
.empty-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #edf1ea;
  border-radius: 34rpx;
  box-shadow: 0 24rpx 56rpx rgba(61, 52, 40, 0.07);
}

.cat-hero {
  padding: 32rpx;
}

.cat-hero-main {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.cat-hero-copy {
  flex: 1;
  min-width: 0;
  padding-top: 28rpx;
}

.cat-hero-title-row {
  display: flex;
  align-items: center;
}

.cat-hero-title {
  display: block;
  font-size: 64rpx;
  line-height: 1.05;
  font-weight: 700;
  color: #234d33;
}

.cat-hero-illustration {
  width: 288rpx;
  height: 236rpx;
  flex-shrink: 0;
}

.cat-hero-logo {
  width: 100%;
  height: 100%;
}

.cat-summary-strip {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.cat-summary-item {
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #eef4ed 0%, #f6f8f3 100%);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cat-summary-item-warm {
  background: linear-gradient(180deg, #fbefdf 0%, #fff7ee 100%);
}

.cat-summary-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 6rpx rgba(232, 241, 230, 0.9);
}

.cat-stat-icon {
  width: 56rpx;
  height: 56rpx;
}

.cat-summary-icon-warm {
  box-shadow: inset 0 0 0 6rpx rgba(255, 244, 228, 0.95);
}

.cat-stat-copy {
  flex: 1;
  min-width: 0;
}

.cat-stat-value,
.trial-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2d4034;
}

.cat-stat-label,
.meta-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #54695b;
}

.segment-wrap {
  margin-top: 22rpx;
}

.segment {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 12rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 40rpx rgba(61, 52, 40, 0.05);
}

.segment-item {
  height: 94rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #7f7267;
  font-size: 28rpx;
}

.segment-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.segment-text {
  line-height: 1;
}

.segment-item-active {
  background: #fffdf9;
  color: #345c4a;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(109, 92, 66, 0.08);
}

.segment-item-active .segment-text {
  color: #2f7e43;
}

.cat-panel {
  margin-top: 22rpx;
  padding: 26rpx;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-copy {
  flex: 1;
  min-width: 0;
}

.panel-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2c4033;
}

.panel-action {
  flex-shrink: 0;
  min-width: 220rpx;
  height: 86rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #edf7ee 0%, #dfefdf 100%);
  border: 1rpx solid #d6e7d6;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.panel-action-soft {
  background: linear-gradient(180deg, #edf7ee 0%, #dfefdf 100%);
  border: 1rpx solid #d6e7d6;
}

.panel-action-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.panel-action-text {
  color: #4b8f53;
  font-size: 28rpx;
  font-weight: 700;
}

.panel-action-soft .panel-action-text {
  color: #4b8f53;
}

.cat-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cat-card {
  padding: 24rpx;
}

.thumb-row {
  width: 100%;
  white-space: nowrap;
}

.thumb {
  width: 250rpx;
  height: 190rpx;
  margin-right: 14rpx;
  border-radius: 24rpx;
  background: #ede4d8;
}

.meta-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 18rpx;
}

.meta-item-wide {
  grid-column: span 2;
}

.meta-value,
.trial-phone,
.trial-link {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4b433c;
  word-break: break-all;
}

.meta-inline {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-inline-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.meta-value-compact {
  margin-left: 40rpx;
}

.panel-link-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ece7dd;
  display: flex;
  justify-content: center;
}

.panel-link {
  color: #3f9a4d;
  font-size: 26rpx;
  font-weight: 700;
}

.trial-card-wrap {
  padding: 20rpx;
}

.trial-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.trial-image {
  width: 156rpx;
  height: 156rpx;
  border-radius: 24rpx;
  background: #ede4d8;
  flex-shrink: 0;
}

.trial-info {
  flex: 1;
  min-width: 0;
}

.trial-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.trial-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.trial-status-success {
  background: #e3f1e8;
  color: #3f7f56;
}

.trial-status-pending {
  background: #f6ead7;
  color: #a56f33;
}

.trial-link {
  color: #5b8564;
  font-weight: 700;
}

.empty-card {
  margin-top: 22rpx;
  padding: 48rpx 26rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #47584c;
}

.empty-text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #859084;
}
