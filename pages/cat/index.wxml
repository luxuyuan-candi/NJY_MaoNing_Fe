<view class="page-shell cat-page">
  <view class="cat-hero">
    <view class="cat-hero-copy">
      <text class="cat-hero-title">猫砂服务</text>
      <view class="cat-stat-grid">
        <view class="cat-stat-card">
          <image class="cat-stat-icon" src="../../images/cat/stat-sale.svg" mode="aspectFit"></image>
          <view class="cat-stat-copy">
            <text class="cat-stat-value">{{saleProducts.length}}</text>
            <text class="cat-stat-label">出售记录</text>
          </view>
        </view>
        <view class="cat-stat-card">
          <image class="cat-stat-icon" src="../../images/cat/stat-trial.svg" mode="aspectFit"></image>
          <view class="cat-stat-copy">
            <text class="cat-stat-value">{{trialProducts.length}}</text>
            <text class="cat-stat-label">试用申请</text>
          </view>
        </view>
      </view>
    </view>
    <image class="cat-hero-logo" src="../../images/cat/hero-logo.png" mode="aspectFit"></image>
  </view>

  <view class="segment-wrap">
    <view class="segment">
      <view class="segment-item {{activeTab === 'sale' ? 'segment-item-active' : ''}}" bindtap="switchInnerTab" data-tab="sale">
        <image class="segment-icon" src="../../images/cat/tab-sale.svg" mode="aspectFit"></image>
        <text class="segment-text">猫砂出售</text>
      </view>
      <view class="segment-item {{activeTab === 'trial' ? 'segment-item-active' : ''}}" bindtap="switchInnerTab" data-tab="trial">
        <image class="segment-icon" src="../../images/cat/tab-trial.svg" mode="aspectFit"></image>
        <text class="segment-text">猫砂试用</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'sale'}}" class="cat-panel">
    <view class="panel-head">
      <view class="panel-copy">
        <text class="panel-title">出售发布</text>
      </view>
      <view class="panel-action" bindtap="goToSaleAdd">
        <image class="panel-action-icon" src="../../images/cat/plus-white.svg" mode="aspectFit"></image>
        <text class="panel-action-text">发布出售</text>
      </view>
    </view>

    <view wx:if="{{saleProducts.length}}" class="cat-list">
      <block wx:for="{{saleProducts}}" wx:key="id">
        <view class="cat-card">
          <scroll-view class="thumb-row" scroll-x="true" enable-flex="true">
            <image
              wx:if="{{item.image}}"
              class="thumb"
              src="{{item.image}}"
              mode="aspectFill"
              bindtap="previewImage"
              data-current="{{item.image}}"
              data-urls="{{[item.image, item.erweiimage, item.ywymimage]}}"
            ></image>
            <image
              wx:if="{{item.erweiimage}}"
              class="thumb"
              src="{{item.erweiimage}}"
              mode="aspectFill"
              bindtap="previewImage"
              data-current="{{item.erweiimage}}"
              data-urls="{{[item.image, item.erweiimage, item.ywymimage]}}"
            ></image>
            <image
              wx:if="{{item.ywymimage}}"
              class="thumb"
              src="{{item.ywymimage}}"
              mode="aspectFill"
              bindtap="previewImage"
              data-current="{{item.ywymimage}}"
              data-urls="{{[item.image, item.erweiimage, item.ywymimage]}}"
            ></image>
          </scroll-view>
          <view class="meta-grid">
            <view class="meta-item">
              <text class="meta-label">规格</text>
              <text class="meta-value">{{item.spec}}</text>
            </view>
            <view class="meta-item">
              <text class="meta-label">总价</text>
              <text class="meta-value">{{item.price}}</text>
            </view>
            <view class="meta-item meta-item-wide">
              <view class="meta-inline">
                <image class="meta-inline-icon" src="../../images/cat/location-green.svg" mode="aspectFit"></image>
                <text class="meta-label">地点</text>
              </view>
              <text class="meta-value meta-value-compact">{{item.location}}</text>
            </view>
            <view class="meta-item">
              <view class="meta-inline">
                <image class="meta-inline-icon" src="../../images/cat/phone-green.svg" mode="aspectFit"></image>
                <text class="meta-label">电话</text>
              </view>
              <text class="meta-value meta-value-compact">{{item.phone}}</text>
            </view>
          </view>
          <view class="panel-link-row">
            <text class="panel-link">查看全部出售信息</text>
          </view>
        </view>
      </block>
    </view>
    <view wx:else class="empty-card">
      <text class="empty-title">暂无出售记录</text>
      <text class="empty-text">发布后会在这里展示猫砂出售内容。</text>
    </view>
  </view>

  <view wx:else class="cat-panel">
    <view class="panel-head">
      <view class="panel-copy">
        <text class="panel-title">试用申请</text>
      </view>
      <view class="panel-action panel-action-soft" bindtap="goToTrialAdd">
        <text class="panel-action-text">申请试用</text>
      </view>
    </view>

    <view wx:if="{{trialProducts.length}}" class="cat-list">
      <block wx:for="{{trialProducts}}" wx:key="id">
        <view class="cat-card trial-card-wrap" bindtap="goToTrialDetail" data-id="{{item.id}}">
          <view class="trial-card">
            <image class="trial-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="trial-info">
              <view class="trial-head">
                <text class="trial-name">{{item.name}}</text>
                <text class="trial-status {{item.status === 'approve' ? 'trial-status-success' : 'trial-status-pending'}}">{{item.statusLabel}}</text>
              </view>
              <text class="trial-phone">联系电话：{{item.phone}}</text>
              <text class="trial-link">查看详情</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <view wx:else class="empty-card">
      <text class="empty-title">暂无试用申请</text>
      <text class="empty-text">提交试用申请后会在这里统一展示。</text>
    </view>
  </view>
</view>
