<view class="page-shell feedback-page">
  <image class="feedback-bg" src="../../images/profile/feedback-bg.jpg" mode="widthFix"></image>

  <view class="feedback-content-wrap">
    <view class="feedback-hero">
      <text class="feedback-title">{{profile.isAdmin ? '反馈管理' : '帮助反馈'}}</text>
    </view>

    <view wx:if="{{profile.isAdmin}}">
      <view class="feedback-stats">
        <image class="feedback-stats-bg" src="../../images/profile/feedback-stats-bg.jpg" mode="aspectFill"></image>
        <view class="stat-box stat-positive">
          <image class="stat-illustration stat-image" src="../../images/profile/feedback-up.png" mode="aspectFit"></image>
          <view class="stat-copy">
            <text class="stat-number">{{stats.positive}}</text>
          </view>
        </view>
        <view class="stat-box stat-negative">
          <image class="stat-illustration stat-image" src="../../images/profile/feedback-down.png" mode="aspectFit"></image>
          <view class="stat-copy">
            <text class="stat-number">{{stats.negative}}</text>
          </view>
        </view>
        <view class="stat-box stat-total">
          <image class="stat-illustration stat-image" src="../../images/profile/feedback-summary.png" mode="aspectFit"></image>
          <view class="stat-copy">
            <text class="stat-number">{{stats.total}}</text>
          </view>
        </view>
      </view>

      <view class="top5-panel" bindtap="goToNegativeTop5">
        <image class="top5-bg" src="../../images/profile/feedback-top5-bg.jpg" mode="aspectFill"></image>
        <text class="top5-text">问题TOP5</text>
        <text class="top5-arrow">›</text>
      </view>

      <view class="feedback-card">
        <view wx:if="{{feedbacks.length}}">
          <block wx:for="{{feedbacks}}" wx:key="id">
            <view class="feedback-item">
              <view class="feedback-avatar">
                <text>{{item.feedbackInitial}}</text>
              </view>
              <view class="feedback-body">
                <view class="feedback-head">
                  <view class="feedback-person">
                    <text class="feedback-name">{{item.nickname}}</text>
                    <text class="feedback-email">{{item.email}}</text>
                  </view>
                  <view class="feedback-date">
                    <view class="calendar-icon"></view>
                    <text>{{item.formattedDate}}</text>
                  </view>
                </view>
                <text class="feedback-content">{{item.content}}</text>
                <view class="feedback-foot">
                  <text class="feedback-category">{{item.problemCategory}}</text>
                  <text class="feedback-sentiment {{item.sentimentClass}}">{{item.sentiment}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
        <view wx:else class="empty-note">当前暂无反馈记录。</view>
      </view>
    </view>

    <view wx:else class="feedback-form-card">
      <view class="form-icon-placeholder"></view>
      <text class="field-label">反馈内容</text>
      <textarea class="feedback-input" placeholder="请输入你的问题、建议或使用反馈" value="{{draft}}" bindinput="onDraftChange" maxlength="300"></textarea>
      <button class="submit-btn" bindtap="submitFeedback">提交反馈</button>
    </view>
  </view>
</view>
