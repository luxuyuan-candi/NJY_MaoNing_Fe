.feedback-page {
  position: relative;
  min-height: 100vh;
  padding: 0 24rpx 64rpx;
  overflow: hidden;
  background: #eef8ef;
  box-sizing: border-box;
}

.feedback-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  z-index: 0;
}

.feedback-content-wrap {
  position: relative;
  z-index: 1;
  padding-top: 132rpx;
}

.feedback-hero {
  min-height: 150rpx;
  padding-left: 44rpx;
  box-sizing: border-box;
}

.feedback-title {
  display: block;
  color: #075b22;
  font-size: 66rpx;
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.feedback-stats {
  display: flex;
  margin-top: 34rpx;
  padding: 14rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 248, 0.78);
  box-shadow: 0 8rpx 20rpx rgba(64, 101, 63, 0.08);
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.feedback-stats-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.stat-box {
  flex: 1;
  min-height: 106rpx;
  padding: 6rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.stat-box + .stat-box::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: rgba(74, 118, 66, 0.22);
}

.stat-illustration {
  width: 72rpx;
  height: 72rpx;
  margin-right: 10rpx;
  position: relative;
  flex-shrink: 0;
}

.stat-image {
  width: 82rpx;
  height: 82rpx;
  margin-right: 8rpx;
}

.stat-copy {
  flex: 0 0 auto;
}

.stat-number {
  display: block;
  color: #0c6a2d;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
}

.stat-negative .stat-number {
  color: #c2631a;
}

.stat-total .stat-number {
  color: #2a6c82;
}

.top5-panel {
  height: 126rpx;
  margin-top: 26rpx;
  padding: 0 28rpx;
  background: transparent;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.top5-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.top5-text {
  position: relative;
  z-index: 1;
  flex: 1;
  color: #0e6b2e;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.top5-arrow {
  position: relative;
  z-index: 1;
  color: #096321;
  font-size: 64rpx;
  line-height: 1;
  font-weight: 700;
}

.feedback-card {
  margin-top: 28rpx;
}

.feedback-item {
  display: flex;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 248, 0.9);
  border: 2rpx solid rgba(207, 225, 190, 0.78);
  box-shadow: 0 8rpx 22rpx rgba(68, 102, 62, 0.1);
  box-sizing: border-box;
}

.feedback-item + .feedback-item {
  margin-top: 22rpx;
}

.feedback-avatar {
  width: 118rpx;
  height: 118rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(160deg, #d8f4ff 0%, #f3f8df 48%, #f6dfbd 100%);
  border: 6rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 -10rpx 20rpx rgba(80, 142, 84, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-avatar text {
  color: #0a6627;
  font-size: 46rpx;
  font-weight: 900;
}

.feedback-body {
  flex: 1;
  min-width: 0;
}

.feedback-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.feedback-person {
  flex: 1;
  min-width: 0;
}

.feedback-name {
  display: block;
  color: #0a5d22;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.feedback-email {
  display: block;
  margin-top: 8rpx;
  color: #72736d;
  font-size: 25rpx;
  line-height: 1.35;
  word-break: break-all;
}

.feedback-date {
  display: flex;
  align-items: center;
  color: #7f817d;
  font-size: 24rpx;
  flex-shrink: 0;
}

.calendar-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border: 4rpx solid #858987;
  border-radius: 6rpx;
  box-sizing: border-box;
  position: relative;
}

.calendar-icon::before {
  content: '';
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: 7rpx;
  height: 4rpx;
  background: #858987;
}

.feedback-content {
  display: block;
  margin-top: 18rpx;
  color: #272a25;
  font-size: 30rpx;
  line-height: 1.52;
}

.feedback-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.feedback-category,
.feedback-sentiment {
  min-width: 112rpx;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-align: center;
  box-sizing: border-box;
}

.feedback-category {
  color: #1d6380;
  background: #dff2fa;
  border: 2rpx solid #bde0ee;
}

.sentiment-positive {
  color: #1d7a34;
  background: #e5f5dc;
  border: 2rpx solid #c5e7b8;
}

.sentiment-negative {
  color: #bd5d16;
  background: #fff0dd;
  border: 2rpx solid #f1c898;
}

.feedback-form-card {
  margin-top: 42rpx;
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 248, 0.92);
  border: 2rpx solid rgba(207, 225, 190, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(68, 102, 62, 0.12);
}

.form-icon-placeholder {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #d8f4ff 0%, #edf7d7 100%);
  border: 6rpx solid rgba(255, 255, 255, 0.94);
}

.field-label {
  display: block;
  color: #0a5d22;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.feedback-input {
  width: 100%;
  height: 360rpx;
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: rgba(247, 251, 239, 0.96);
  border: 2rpx solid rgba(198, 224, 157, 0.88);
  color: #2e2a26;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #4b9b46 0%, #167233 100%);
  box-shadow: 0 12rpx 24rpx rgba(42, 113, 49, 0.18);
}

.submit-btn::after {
  border: none;
}

.empty-note {
  padding: 60rpx 0;
  text-align: center;
  color: #6f7668;
  font-size: 26rpx;
}
