.feedback-page {
  background:
    radial-gradient(circle at top left, rgba(239, 229, 214, 0.8), transparent 32%),
    linear-gradient(180deg, #f7f4ef 0%, #f5efe7 100%);
}

.feedback-hero,
.feedback-card {
  padding: 30rpx;
}

.feedback-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2f342f;
}

.feedback-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f7469;
}

.feedback-card {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #8b7b6f;
}

.feedback-input {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f7f3ed;
  color: #2e2a26;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  margin-top: 24rpx;
}

.feedback-item + .feedback-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e0d8ce;
}

.feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.feedback-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #32312d;
}

.feedback-time,
.feedback-email {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a7d72;
}

.feedback-content {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #48413a;
}

.empty-note {
  padding: 40rpx 0 10rpx;
  text-align: center;
  color: #8a7d72;
}
