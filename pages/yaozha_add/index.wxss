page {
  background:
    radial-gradient(circle at top right, rgba(240, 235, 220, 0.72), transparent 30%),
    radial-gradient(circle at top left, rgba(225, 238, 226, 0.88), transparent 34%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.add-page.page-shell {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-right: 18rpx;
  padding-left: 18rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.intro-card,
.form-card {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid #ecf0e8;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 44rpx rgba(61, 52, 40, 0.06);
}

.intro-card {
  padding: 22rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.26;
  font-weight: 700;
  color: #338347;
}

.intro-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #66766c;
}

.intro-image {
  width: 194rpx;
  height: 132rpx;
  flex-shrink: 0;
}

.form-card {
  margin-top: 10rpx;
  padding: 4rpx 16rpx 12rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.form-main {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.form-footer {
  margin-top: auto;
  padding-top: 10rpx;
}

.section-item {
  padding: 6rpx 0 7rpx;
  border-bottom: 1rpx solid #e8ede7;
}

.section-item-last {
  border-bottom: none;
  padding-bottom: 2rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
}

.section-inline-value {
  margin-left: auto;
  flex: 1;
  min-width: 0;
  padding-top: 3rpx;
  font-size: 17rpx;
  line-height: 1.28;
  color: #a1aaa3;
  text-align: right;
  white-space: normal;
  word-break: break-all;
}

.section-inline-value-active {
  color: #617264;
}

.section-icon-wrap {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #edf5ec;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-icon {
  width: 20rpx;
  height: 20rpx;
}

.section-title {
  padding-top: 2rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #202622;
}

.required-mark {
  color: #e26a57;
  padding-top: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.radio-group {
  margin-top: 3rpx;
  display: flex;
  gap: 28rpx;
  padding-left: 44rpx;
}

.radio-item {
  font-size: 23rpx;
  color: #25302a;
  display: flex;
  align-items: center;
}

.field-input,
.picker-field {
  margin-top: 3rpx;
  margin-left: 44rpx;
  height: 54rpx;
  border: 1rpx solid #d9dfd8;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.field-input {
  width: calc(100% - 44rpx);
  padding: 0 14rpx;
  line-height: 54rpx;
  font-size: 22rpx;
  color: #2c312d;
}

.picker-field {
  width: calc(100% - 44rpx);
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 22rpx;
  color: #a0a7a1;
}

.picker-text-active {
  color: #2c312d;
}

.picker-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: #9aa49d;
}

.action-btn {
  margin-top: 3rpx;
  margin-left: 44rpx;
  width: calc(100% - 44rpx);
  height: 54rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.location-btn {
  border-radius: 14rpx;
  background: linear-gradient(180deg, #55a45d 0%, #45924f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  width: 22rpx;
  height: 22rpx;
}

.btn-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.checkbox-group {
  margin-top: 3rpx;
  margin-left: 44rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.check-item {
  min-width: 112rpx;
  height: 46rpx;
  padding: 0 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d9dfd8;
  background: #ffffff;
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #2b312d;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 0;
  margin-left: 0;
  width: 100%;
  height: 74rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #57a85d 0%, #44944f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn-text {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  line-height: 1;
}

.privacy-tip {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.privacy-icon {
  width: 18rpx;
  height: 18rpx;
}

.privacy-text {
  font-size: 18rpx;
  color: #748178;
}
