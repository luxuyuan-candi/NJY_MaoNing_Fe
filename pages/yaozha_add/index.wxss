page {
  background:
    radial-gradient(circle at top right, rgba(240, 235, 220, 0.72), transparent 30%),
    radial-gradient(circle at top left, rgba(225, 238, 226, 0.88), transparent 34%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.add-page {
  min-height: 100vh;
  padding-bottom: 12rpx;
}

.intro-card,
.form-card {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid #ecf0e8;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 44rpx rgba(61, 52, 40, 0.06);
}

.intro-card {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.32;
  font-weight: 700;
  color: #338347;
}

.intro-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #66766c;
}

.intro-image {
  width: 220rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.form-card {
  margin-top: 16rpx;
  padding: 4rpx 22rpx 18rpx;
}

.section-item {
  padding: 16rpx 0 18rpx;
  border-bottom: 1rpx solid #e8ede7;
}

.section-item-last {
  border-bottom: none;
  padding-bottom: 10rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #edf5ec;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-icon {
  width: 28rpx;
  height: 28rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #202622;
}

.required-mark {
  color: #e26a57;
  font-size: 24rpx;
  font-weight: 700;
}

.radio-group {
  margin-top: 14rpx;
  display: flex;
  gap: 42rpx;
  padding-left: 66rpx;
}

.radio-item {
  font-size: 24rpx;
  color: #25302a;
  display: flex;
  align-items: center;
}

.field-input,
.picker-field {
  margin-top: 12rpx;
  margin-left: 66rpx;
  height: 68rpx;
  border: 1rpx solid #d9dfd8;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.field-input {
  width: calc(100% - 66rpx);
  padding: 0 16rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  color: #2c312d;
}

.picker-field {
  width: calc(100% - 66rpx);
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 24rpx;
  color: #a0a7a1;
}

.picker-text-active {
  color: #2c312d;
}

.picker-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #9aa49d;
}

.action-btn {
  margin-top: 12rpx;
  margin-left: 66rpx;
  width: calc(100% - 66rpx);
  height: 68rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.location-btn {
  border-radius: 16rpx;
  background: linear-gradient(180deg, #55a45d 0%, #45924f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-icon {
  width: 26rpx;
  height: 26rpx;
}

.btn-icon-light {
  filter: brightness(0) invert(1);
}

.btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.location-text {
  margin-top: 8rpx;
  margin-left: 66rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #5a6d61;
}

.checkbox-group {
  margin-top: 12rpx;
  margin-left: 66rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.check-item {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d9dfd8;
  background: #ffffff;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #2b312d;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #57a85d 0%, #44944f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn-text {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  line-height: 1;
}

.privacy-tip {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.privacy-icon {
  width: 22rpx;
  height: 22rpx;
}

.privacy-text {
  font-size: 20rpx;
  color: #748178;
}
