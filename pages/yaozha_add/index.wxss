page {
  background:
    radial-gradient(circle at top right, rgba(240, 235, 220, 0.72), transparent 30%),
    radial-gradient(circle at top left, rgba(225, 238, 226, 0.88), transparent 34%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.add-page.page-shell {
  min-height: 100vh;
  padding-top: 16rpx;
  padding-right: 18rpx;
  padding-left: 18rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.intro-card,
.form-card {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid #ecf0e8;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 44rpx rgba(61, 52, 40, 0.06);
}

.intro-card {
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #338347;
}

.intro-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #66766c;
}

.intro-image {
  width: 204rpx;
  height: 138rpx;
  flex-shrink: 0;
}

.form-card {
  margin-top: 10rpx;
  padding: 8rpx 16rpx 14rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.form-main {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.form-footer {
  margin-top: auto;
  padding-top: 16rpx;
}

.section-item {
  padding: 10rpx 0 12rpx;
  border-bottom: 1rpx solid #e8ede7;
}

.section-item-last {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.section-inline-value {
  margin-left: auto;
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.35;
  color: #a1aaa3;
  text-align: right;
  white-space: normal;
  word-break: break-all;
}

.section-inline-value-active {
  color: #617264;
}

.section-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #edf5ec;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-icon {
  width: 22rpx;
  height: 22rpx;
}

.section-title {
  padding-top: 4rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #202622;
}

.required-mark {
  color: #e26a57;
  padding-top: 4rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.radio-group {
  margin-top: 8rpx;
  display: flex;
  gap: 28rpx;
  padding-left: 44rpx;
}

.radio-item {
  font-size: 24rpx;
  color: #25302a;
  display: flex;
  align-items: center;
}

.field-input,
.picker-field {
  margin-top: 8rpx;
  margin-left: 44rpx;
  height: 62rpx;
  border: 1rpx solid #d8e2d8;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdfb 100%);
  box-shadow:
    0 10rpx 22rpx rgba(92, 110, 93, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.field-input {
  width: calc(100% - 44rpx);
  padding: 0 18rpx;
  line-height: 62rpx;
  font-size: 23rpx;
  color: #2c312d;
}

.picker-field {
  width: calc(100% - 44rpx);
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 23rpx;
  color: #a0a7a1;
}

.picker-text-active {
  color: #2c312d;
  font-weight: 500;
}

.picker-arrow {
  font-size: 32rpx;
  line-height: 1;
  color: #82a088;
}

.action-btn {
  margin-top: 8rpx;
  margin-left: 44rpx;
  width: calc(100% - 44rpx);
  height: 62rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.location-btn {
  border-radius: 16rpx;
  background: linear-gradient(180deg, #55a45d 0%, #45924f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  width: 24rpx;
  height: 24rpx;
}

.btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.checkbox-group {
  margin-top: 8rpx;
  margin-left: 44rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.check-item {
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 14rpx 0 10rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d7e2d7;
  background: linear-gradient(180deg, #ffffff 0%, #f7fbf7 100%);
  box-shadow:
    0 8rpx 18rpx rgba(92, 110, 93, 0.07),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #334236;
  box-sizing: border-box;
}

.check-item checkbox {
  transform: scale(0.8);
  transform-origin: left center;
  margin-right: 4rpx;
}

.submit-btn {
  margin-top: 0;
  margin-left: 0;
  width: 100%;
  height: 82rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #57a85d 0%, #44944f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn-text {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  line-height: 1;
}

.privacy-tip {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.privacy-icon {
  width: 18rpx;
  height: 18rpx;
}

.privacy-text {
  font-size: 18rpx;
  color: #748178;
}
