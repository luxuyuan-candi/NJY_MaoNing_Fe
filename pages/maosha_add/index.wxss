.form-page {
  background:
    radial-gradient(circle at top right, rgba(220, 236, 223, 0.8), transparent 28%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.intro-card,
.form-card {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid #ecf0e8;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 44rpx rgba(61, 52, 40, 0.06);
}

.intro-card {
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #284b36;
}

.intro-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #708073;
}

.intro-badge {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #eef7ee 0%, #dfeee1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.intro-badge-icon {
  width: 56rpx;
  height: 56rpx;
}

.form-card {
  margin-top: 20rpx;
  padding: 10rpx 22rpx 24rpx;
}

.section-item {
  padding: 18rpx 0 20rpx;
  border-bottom: 1rpx solid #e8ede7;
}

.section-item-last {
  border-bottom: none;
  padding-bottom: 12rpx;
}

.section-head {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #243229;
}

.section-inline {
  margin-left: auto;
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: right;
  color: #a1aaa3;
  word-break: break-all;
}

.section-inline-active {
  color: #617264;
}

.upload-card {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f2f8f2 0%, #e8f1e8 100%);
  border: 1rpx solid #dde9dd;
}

.upload-card-soft {
  background: linear-gradient(180deg, #fbf7f0 0%, #f3ede3 100%);
  border-color: #ebe1d2;
}

.upload-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #425847;
}

.upload-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7d8b80;
}

.preview {
  width: 100%;
  height: 280rpx;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #ece5da;
}

.field-input {
  margin-top: 12rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid #d8e2d8;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdfb 100%);
  box-shadow: 0 10rpx 22rpx rgba(92, 110, 93, 0.08);
  font-size: 25rpx;
  color: #2c312d;
  box-sizing: border-box;
}

.location-btn,
.submit-btn {
  margin-top: 12rpx;
  height: 78rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
}

.location-btn {
  background: linear-gradient(180deg, #58a45f 0%, #448f4d 100%);
  color: #ffffff;
}

.submit-btn {
  margin-top: 18rpx;
  background: linear-gradient(180deg, #365e46 0%, #294936 100%);
  color: #ffffff;
}
