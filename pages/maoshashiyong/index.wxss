.trial-page {
  background:
    radial-gradient(circle at top right, rgba(220, 236, 223, 0.8), transparent 28%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.trial-hero {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #284b36;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #708073;
}

.hero-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f8f1e5 0%, #efe2cd 100%);
  color: #8f6e47;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-row {
  margin-top: 20rpx;
}

.action-btn {
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #c79a5d 0%, #af8144 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trial-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.trial-card-wrap {
  padding: 22rpx;
}

.trial-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.trial-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: #ece4d9;
  flex-shrink: 0;
}

.trial-info {
  flex: 1;
  min-width: 0;
}

.trial-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.trial-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2e2a26;
}

.trial-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.trial-status-success {
  background: #e3f1e8;
  color: #3f7f56;
}

.trial-status-pending {
  background: #f6ead7;
  color: #a56f33;
}

.trial-phone,
.trial-link {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #4b433c;
}

.trial-link {
  color: #7f6d53;
  font-weight: 700;
}
