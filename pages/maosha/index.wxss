.cat-subpage {
  background:
    radial-gradient(circle at top right, rgba(220, 236, 223, 0.8), transparent 28%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.sale-hero {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #284b36;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #708073;
}

.hero-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #eff7ee 0%, #dfeee1 100%);
  color: #4d8b5a;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-row {
  margin-top: 20rpx;
}

.action-btn {
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #58a45f 0%, #448f4d 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sale-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.sale-card {
  padding: 24rpx;
}

.thumb-row {
  width: 100%;
  white-space: nowrap;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  margin-right: 16rpx;
  border-radius: 22rpx;
  background: #ede4d8;
}

.meta-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 16rpx;
}

.meta-item-wide {
  grid-column: span 2;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: #8a7f74;
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #4b433c;
  word-break: break-all;
}
