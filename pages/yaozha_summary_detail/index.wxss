page {
  background:
    radial-gradient(circle at top right, rgba(240, 235, 220, 0.72), transparent 30%),
    radial-gradient(circle at top left, rgba(225, 238, 226, 0.88), transparent 34%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.summary-detail-page {
  min-height: 100vh;
}

.chart-card,
.tips-card {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid #ecf0e8;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 44rpx rgba(61, 52, 40, 0.06);
}

.chart-card {
  padding: 28rpx;
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chart-title-wrap {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.chart-icon-wrap,
.detail-icon-wrap,
.tips-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #edf5ec;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chart-icon,
.detail-icon,
.tips-icon {
  width: 40rpx;
  height: 40rpx;
}

.chart-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2922;
}

.chart-container {
  width: 100%;
  height: 760rpx;
  margin-top: 10rpx;
}

.detail-info-card {
  margin-top: 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e6ebe4;
  overflow: hidden;
}

.detail-item {
  min-height: 126rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx dashed #dce6d9;
}

.detail-item-last {
  border-bottom: none;
}

.detail-copy {
  flex: 1;
  min-width: 0;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #63746a;
}

.detail-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #1f1f1f;
  word-break: break-all;
}

.tips-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.tips-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.tips-copy {
  min-width: 0;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2f7a3b;
}

.tips-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #56655c;
}

.tips-image {
  width: 210rpx;
  height: 120rpx;
  flex-shrink: 0;
}

