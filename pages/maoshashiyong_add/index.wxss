.form-page {
  background:
    radial-gradient(circle at top right, rgba(237, 229, 215, 0.85), transparent 30%),
    linear-gradient(180deg, #f8f5ef 0%, #f2eee5 100%);
}

.intro-card,
.form-card {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid #ecf0e8;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 44rpx rgba(61, 52, 40, 0.06);
}

.intro-card {
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #5f4a2e;
}

.intro-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f7468;
}

.intro-badge {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f7efe4 0%, #efe1cc 100%);
  color: #8f6e47;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-card {
  margin-top: 20rpx;
  padding: 10rpx 22rpx 24rpx;
}

.section-item {
  padding: 18rpx 0 20rpx;
  border-bottom: 1rpx solid #ece3d7;
}

.section-item-last {
  border-bottom: none;
  padding-bottom: 12rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #3e3429;
}

.upload-card {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fbf7f0 0%, #f2e8d8 100%);
  border: 1rpx solid #ebe1d2;
}

.upload-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5f513f;
}

.upload-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a7d6d;
}

.preview {
  width: 100%;
  height: 280rpx;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: #ece5da;
}

.field-input {
  margin-top: 12rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e5ddd0;
  background: linear-gradient(180deg, #ffffff 0%, #fcfaf6 100%);
  box-shadow: 0 10rpx 22rpx rgba(102, 84, 60, 0.06);
  font-size: 25rpx;
  color: #2c312d;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 18rpx;
  height: 78rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #c79a5d 0%, #af8144 100%);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
