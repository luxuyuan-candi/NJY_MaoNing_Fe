<view class="page-shell settings-page">
  <view class="profile-card settings-hero">
    <view class="avatar-panel">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-fallback">头像</view>
      </button>
      <text class="avatar-hint">点击默认使用微信头像</text>
    </view>
    <view class="settings-copy">
      <text class="settings-title">个人信息配置</text>
      <text class="settings-subtitle">维护头像、昵称、邮箱与用户类型。</text>
    </view>
  </view>

  <view class="profile-card form-card">
    <view class="field">
      <text class="field-label">昵称</text>
      <input class="field-input" placeholder="请输入昵称" value="{{profile.nickname}}" data-field="nickname" bindinput="onInputChange"/>
    </view>
    <view class="field">
      <text class="field-label">邮箱地址</text>
      <input class="field-input" placeholder="请输入邮箱地址" value="{{profile.email}}" data-field="email" bindinput="onInputChange"/>
    </view>
    <view class="field field-last">
      <text class="field-label">用户类型</text>
      <picker mode="selector" range="{{userTypes}}" value="{{userTypeIndex}}" bindchange="onTypeChange">
        <view class="field-input picker-field">{{profile.userType}}</view>
      </picker>
    </view>
    <button class="primary-btn save-btn" bindtap="saveSettings">保存配置</button>
  </view>
</view>
