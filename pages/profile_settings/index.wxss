.settings-page {
  min-height: 100vh;
  padding: 30rpx 24rpx 28rpx;
  background:
    radial-gradient(circle at top left, rgba(219, 235, 200, 0.72), transparent 18%),
    radial-gradient(circle at top right, rgba(218, 235, 204, 0.7), transparent 18%),
    radial-gradient(circle at bottom right, rgba(217, 235, 199, 0.75), transparent 18%),
    linear-gradient(180deg, #faf6ed 0%, #f7f2e8 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.settings-hero {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 252, 246, 0.96) 0%, rgba(251, 247, 238, 0.94) 100%);
  box-shadow: 0 18rpx 40rpx rgba(176, 172, 132, 0.12);
  position: relative;
  overflow: hidden;
}

.settings-hero::before,
.settings-hero::after {
  content: '';
  position: absolute;
  background: rgba(129, 174, 99, 0.16);
  filter: blur(2rpx);
}

.settings-hero::before {
  width: 128rpx;
  height: 128rpx;
  top: -12rpx;
  right: -10rpx;
  border-radius: 0 0 0 100%;
}

.settings-hero::after {
  width: 156rpx;
  height: 98rpx;
  right: 18rpx;
  bottom: -10rpx;
  border-radius: 100% 100% 0 0;
}

.avatar-panel {
  width: 138rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.avatar-button {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(180deg, #75a95a 0%, #5f9146 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 28rpx rgba(116, 149, 91, 0.16);
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.camera-badge {
  position: absolute;
  left: 70rpx;
  bottom: -10rpx;
  width: 46rpx;
  height: 46rpx;
}

.camera-badge-icon {
  width: 46rpx;
  height: 46rpx;
}

.settings-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
  padding-left: 8rpx;
}

.settings-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2c372f;
  letter-spacing: 1rpx;
}

.settings-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #726b5f;
}

.form-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 252, 246, 0.94);
  box-shadow: 0 18rpx 40rpx rgba(176, 172, 132, 0.12);
  min-height: 640rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.field {
  margin-bottom: 24rpx;
}

.field-last {
  margin-bottom: 28rpx;
}

.field-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.field-title-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #556548;
}

.field-title-leaf {
  margin-left: 8rpx;
  color: #97b56f;
  font-size: 24rpx;
  line-height: 1;
}

.field-input-shell {
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f9f6ef 0%, #f6f1e7 100%);
  box-shadow:
    inset 0 0 0 2rpx rgba(240, 234, 220, 0.95),
    0 10rpx 22rpx rgba(188, 179, 147, 0.08);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.field-input-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  height: 84rpx;
  color: #2e2a26;
  font-size: 24rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #77a85c 0%, #5b8f45 100%);
  box-shadow: 0 14rpx 30rpx rgba(106, 145, 79, 0.22);
  padding: 0;
  margin-top: auto;
}

.save-btn-inner {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.save-btn-text {
  color: #f7fbf2;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
