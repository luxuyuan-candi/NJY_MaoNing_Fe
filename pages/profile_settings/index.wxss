.settings-page {
  background:
    radial-gradient(circle at top right, rgba(225, 238, 226, 0.82), transparent 28%),
    linear-gradient(180deg, #f7f4ef 0%, #f5efe7 100%);
}

.settings-hero,
.form-card {
  padding: 30rpx;
}

.settings-hero {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.avatar-panel {
  width: 180rpx;
  flex-shrink: 0;
}

.avatar-button {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(180deg, #4f8e5c 0%, #3a6e49 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.avatar-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #7f7469;
  text-align: center;
}

.settings-copy {
  flex: 1;
  min-width: 0;
}

.settings-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2f342f;
}

.settings-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f7469;
}

.form-card {
  margin-top: 22rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-last {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #8b7b6f;
}

.field-input {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #f7f3ed;
  color: #2e2a26;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-field {
  justify-content: space-between;
}

.save-btn {
  width: 100%;
}
