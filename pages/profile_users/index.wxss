.users-page {
  background:
    radial-gradient(circle at top left, rgba(239, 229, 214, 0.8), transparent 32%),
    linear-gradient(180deg, #f7f4ef 0%, #f5efe7 100%);
}

.users-hero,
.users-card {
  padding: 30rpx;
}

.users-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2f342f;
}

.users-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f7469;
}

.users-card {
  margin-top: 22rpx;
}

.user-item + .user-item {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed #e0d8ce;
}

.user-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.user-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(180deg, #4f8e5c 0%, #3a6e49 100%);
  flex-shrink: 0;
}

.user-avatar-image,
.user-avatar-fallback {
  width: 100%;
  height: 100%;
}

.user-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.user-copy {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #34312d;
  word-break: break-all;
}

.user-email {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7f7469;
  word-break: break-all;
}

.user-type-picker {
  min-width: 150rpx;
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #edf5ec;
  color: #4c7a57;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.user-type-picker.readonly {
  background: #f1eee8;
  color: #8a7d72;
}

.empty-note {
  padding: 40rpx 0 10rpx;
  text-align: center;
  color: #8a7d72;
}
